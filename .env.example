# ESPN account cookies. Same values as the Fantasy Rankings project — they are
# account-level, not league-scoped, so they reach all four leagues.
ESPN_S2=
ESPN_SWID=
ESPN_SEASON_YEAR=2026

# Locks the settings panel. Unset = settings open, and the page says so.
# At least 12 characters. Set it with the command Claude gives you, not by hand.
# SITE_PASSPHRASE=
